  <property name="styleSheet">
   <string notr="true">/* --- Main Window Style --- */
QWidget#MainWindow, QWidget#scrollAreaWidgetContents { background-color: #FFFFFF; color: #2D3748; }
QScrollArea#scrollArea { border: none; }

/* --- Section Titles --- */
QLabel#importRunLabel, QLabel#resultsLabel, QLabel#visualizeLabel { font-size: 18px; font-weight: bold; color: #1A202C; padding: 5px; border-bottom: 2px solid #007B83; }

/* --- Info Labels --- */
QLabel#projectPathLabel { font-size: 14px; color: #718096; }
QLabel#inputChosenLabel { font-size: 14px; color: #007B83; font-weight: bold; }

/* --- List Widget --- */
QListWidget { background-color: #F7FAFC; border: 1px solid #CBD5E0; border-radius: 10px; font-size: 14px; color: #2D3748; }
QListWidget::item { padding: 8px; border-radius: 5px; }
QListWidget::item:hover { background-color: #EDF2F7; border: 1px solid #007B83; }
QListWidget::item:selected { background-color: #007B83; color: #FFFFFF; }

/* --- Buttons --- */
QPushButton { background-color: #FFFFFF; color: #007B83; border: 2px solid #007B83; border-radius: 8px; padding: 10px; font-size: 14px; font-weight: bold; }
QPushButton:hover { background-color: #E6F2F3; }
QPushButton:pressed { background-color: #007B83; color: #FFFFFF; }
QPushButton#poseButton { background-color: #007B83; color: #FFFFFF; font-size: 16px; }
QPushButton#poseButton:hover { background-color: #005A60; }
QPushButton#poseButton:disabled { background-color: #EDF2F7; color: #A0AEC0; border: 2px solid #CBD5E0; }

/* Small Delete Button */
QPushButton#deleteRunButton { padding: 4px 8px; font-size: 12px; color: #E53E3E; border: 1px solid #FC8181; border-radius: 4px; }
QPushButton#deleteRunButton:hover { background-color: #FFF5F5; }
QPushButton#deleteRunButton:disabled { color: #CBD5E0; border: 1px solid #E2E8F0; }

/* --- Separator Line and Logs --- */
QFrame#line { border: 1px solid #E2E8F0; }
QPlainTextEdit#logOutput { background-color: #F7FAFC; border: 1px solid #CBD5E0; border-radius: 5px; color: #2D3748; font-family: Consolas, monospaced; }

/* --- Master Player Controls --- */
QPushButton#rewindButton { padding: 5px 10px; font-size: 16px; border-radius: 5px; }
QPushButton#syncPlayButton { padding: 5px 15px; font-size: 14px; background-color: #007B83; color: white; border-radius: 5px; }
QLabel#masterTimeLabel { color: #4A5568; font-weight: bold; font-size: 12px; }
QSlider::groove:horizontal { border: 1px solid #CBD5E0; height: 6px; background: #EDF2F7; margin: 2px 0; border-radius: 3px; }
QSlider::handle:horizontal { background: #007B83; border: 1px solid #FFFFFF; width: 18px; margin: -6px 0; border-radius: 9px; }
QSlider::handle:horizontal:hover { background: #005A60; }
</string>
  </property>
