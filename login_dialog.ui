  <property name="styleSheet">
   <string notr="true">/* --- Main Dialog Style --- */
QWidget#LoginWidget {
	background-color: #FFFFFF;
    border: 2px solid #007B83;
	border-radius: 10px;
}

QLabel {
	color: #2D3748;
	font-family: "Segoe UI", Arial, sans-serif;
	font-size: 14px;
}

QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: #007B83;
}

QLabel#statusLabel {
	font-size: 12px;
}

QLineEdit {
	background-color: #FFFFFF;
	border: 1px solid #CBD5E0;
	border-radius: 5px;
	padding: 8px;
	font-size: 14px;
	color: #2D3748;
}

QLineEdit:focus {
	border-color: #007B83;
}

QDialogButtonBox QPushButton {
	background-color: #FFFFFF;
	color: #007B83;
    min-width: 80px;
    padding: 6px 12px;
	border: 2px solid #007B83;
    border-radius: 5px;
    font-weight: bold;
}

QDialogButtonBox QPushButton:hover {
	background-color: #E6F2F3;
}

QDialogButtonBox QPushButton[text="Log In"] {
	background-color: #007B83;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton[text="Log In"]:hover {
	background-color: #005A60;
}
</string>
