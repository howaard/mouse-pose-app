  <property name="styleSheet">
   <string notr="true">/* --- Main Window Style --- */
QWidget#WelcomeWidget {
    background-color: #FFFFFF;
}

/* --- Label Styles --- */
QLabel {
    color: #2D3748;
    font-family: "Segoe UI", Arial, sans-serif;
}

QLabel#logoLabel {
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.4,
        fx:0.5, fy:0.5,
        stop:0 rgba(0, 0, 0, 10),
        stop:1 transparent
    );
    border: none;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #000000;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: #007B83;
}

/* --- Main Action Buttons --- */
QPushButton {
    background-color: #FFFFFF;
    color: #007B83;
    border: 2px solid #007B83;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    min-width: 200px;
}

QPushButton:hover {
    background-color: #007B83; 
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #005A60;
    color: #FFFFFF;
}

/* --- Top Right Login Button --- */
QPushButton#loginButton {
    min-width: 100px;
    padding: 8px 16px;
    font-size: 14px;
    border: 1px solid #007B83;
    border-radius: 6px;
}
</string>
