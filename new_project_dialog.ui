  <property name="styleSheet">
   <string notr="true">/* --- Main Dialog Style --- */
QWidget#NewProjectWidget {
	background-color: #FFFFFF;
    border: 2px solid #007B83; /* Clinical Teal border to pop */
	border-radius: 10px;
}

/* --- Label Styles --- */
QLabel {
	color: #2D3748;
	font-family: "Segoe UI", Arial, sans-serif;
	font-size: 14px;
}

QLabel#statusLabel {
	font-size: 12px;
}

/* --- LineEdit Styles --- */
QLineEdit {
	background-color: #FFFFFF;
	border: 1px solid #CBD5E0;
	border-radius: 5px;
	padding: 8px;
	font-size: 14px;
	color: #2D3748;
}

QLineEdit:focus {
	border-color: #007B83;
}

/* Make read-only fields look different */
QLineEdit:read-only {
    background-color: #EDF2F7;
    color: #718096;
}

/* --- QDialogButtonBox Styles --- */
QDialogButtonBox QPushButton {
	background-color: #FFFFFF;
	color: #007B83;
    min-width: 60px;
    padding: 6px 12px;
	border: 2px solid #007B83;
    border-radius: 5px;
    font-weight: bold;
}

QDialogButtonBox QPushButton:hover {
	background-color: #E6F2F3;
}

QDialogButtonBox QPushButton:disabled {
	background-color: #EDF2F7;
	color: #A0AEC0;
    border: 2px solid #CBD5E0;
}

QDialogButtonBox QPushButton[text="OK"] {
	background-color: #007B83;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton[text="OK"]:hover {
	background-color: #005A60;
}
</string>
